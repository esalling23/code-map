{
  "name": "@eronsalling23/code-map",
  "version": "0.1.0",
  "description": "Generate a code-map: a JSON sitemap of how code runs (for agents) and a viewer that draws it as a system diagram and walkthrough (for people).",
  "keywords": [
    "code-map",
    "mcp",
    "documentation",
    "architecture",
    "typescript",
    "onboarding",
    "diagram"
  ],
  "license": "MIT",
  "author": "esalling23",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esalling23/code-map.git"
  },
  "homepage": "https://esalling23.github.io/code-map/",
  "bugs": {
    "url": "https://github.com/esalling23/code-map/issues"
  },
  "type": "module",
  "bin": {
    "code-map": "src/cli.ts",
    "code-map-mcp": "src/mcp.ts"
  },
  "files": [
    "src",
    "docs/agents",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "map": "bun run src/cli.ts",
    "view": "bun run src/cli.ts view",
    "mcp": "bun run src/mcp.ts",
    "build:viewer": "bun run scripts/build-viewer.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.1.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
